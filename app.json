{
  "expo": {
    "name": "LiftLog",
    "slug": "liftlog",
    "scheme": "liftlog",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1115",
    "ios": {
      "bundleIdentifier": "com.sirak.liftlog",
      "supportsTablet": false
    },
    "android": {
      "package": "com.sirak.liftlog"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#3b82f6"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ddbbf11-2a68-445e-995f-7d67541ed47f"
      }
    }
  }
}
